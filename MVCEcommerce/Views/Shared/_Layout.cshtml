@inject DbcontextEcommerce? dbcontext
@using System.Security.Claims

@{
    var catalogs = new List<Catalog>();
    var categories = new List<Category>();
    int shoppingCartCount = 0;

    if (dbcontext != null)
    {
        catalogs = dbcontext.Catalogs
            .Where(p => p.IsEnabled && p.Products.Any(q => q.IsEnabled))
            .OrderBy(p => p.NameEn)
            .ToList();

        categories = dbcontext.Categories
            .Where(p => p.IsEnabled && p.Products.Any(q => q.IsEnabled))
            .OrderBy(p => p.NameEn)
            .ToList();

        if (User?.Identity?.IsAuthenticated ?? false)
        {
            var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (!string.IsNullOrEmpty(userIdStr) && Guid.TryParse(userIdStr, out var userId))
            {
                shoppingCartCount = dbcontext.ShoppingCartItems
                    .Where(p => p.UserId == userId)
                    .Sum(p => (int?)p.Quantity) ?? 0;
            }
        }
    }
}

<!DOCTYPE html>
<html>
<head>
    <title>  @ViewData["Title"] - MVC E-Commerce </title>
    <meta name="viewport" content="width=device-width" />
    <link href="~/css/site.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary py-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="text-warning fw-bold">MVC</span><span class="text-body-secondary">E-Commerce</span>

            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <form asp-controller="Home" asp-action="Search" method="get" class="d-flex" role="search">
                <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" name="keyword" />
                <button class="btn btn-outline-success" type="submit">Search</button>
            </form>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mb-2 mb-lg-0">
                </ul>
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="#">Home</a>
                    </li>


                    <li class="nav-item app-dropdown-toggle">
                        <a class="nav-link " href="#">Catalog</a>
                        <div class="app-dropdown">
                            <ul class="nav flex-column">
                                @foreach (var catalog in catalogs)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-truncate overflow-hidden app-dropdown-toggle" asp-route="Catalog" asp-route-name="@catalog.NameEn.ToSafeUrlString()" asp-route-id="@catalog.Id">@catalog.NameEn</a>
                                    </li>

                                }
                            </ul>
                        </div>
                    </li>
                    <li class="nav-item app-dropdown-toggle">
                        <a class="nav-link " href="#">Categories</a>
                        <div class="app-dropdown">
                            <ul class="nav flex-column">
                                @foreach (var category in categories)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-truncate overflow-hidden app-dropdown-toggle" asp-route="Category" asp-route-name="@category.NameEn.ToSafeUrlString()" asp-route-id="@category.Id">@category.NameEn</a>
                                    </li>

                                }
                            </ul>
                        </div>
                    </li>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {


                        <li class="nav-item">
                            <a class="nav-link" asp-action="Profile" asp-controller="Account">
                                <i class="bi bi-person"></i>
                                @User.FindFirst(ClaimTypes.GivenName)?.Value

                            </a>
                        </li>
                        <li class="nav-item me-2">
                            <a asp-action="Checkout" asp-controller="Account" class="nav-item btn btn-link position-relative">
                                <i class="bi bi-cart"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @(shoppingCartCount > 99 ? "99+" : shoppingCartCount)
                                </span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Logout" asp-controller="Account">
                                <i class="bi bi-power "></i>
                                Signout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Login" asp-controller="Account">
                                <i class="bi bi-person-check"></i>
                                Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Register" asp-controller="Account">
                                <i class="bi bi-person-plus"></i>
                                Register
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>
    <main class="container">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-3 ">
        <div class="container">
            <div class="row">
                <div class="col-12 col-md-4">
                    <ul class="nav flex-column">
                        @foreach (var catalog in catalogs)
                        {
                            <li class="nav-item">

                                <a asp-route="Catalog" asp-route-id="@catalog.Id" asp-route-name="@catalog.NameEn.ToSafeUrlString()" class="nav-link text-white">
                                    @catalog.NameEn
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-12 col-md-4">
                    <ul class="nav flex-column">
                        @foreach (var category in categories)
                        {
                            <li class="nav-item">

                                <a asp-route="Category" asp-route-id="@category.Id" asp-route-name="@category.NameEn.ToSafeUrlString()" class="nav-link text-white">
                                    @category.NameEn
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-12 col-md-4 d-flex flex-column align-items-center gap-3 ">
                    <div class="d-flex align-items-center justify-content-center gap-3">

                    <a href="www.instagram.com">
                        <i class=" bi bi-instagram text-light fs-2"></i>
                    </a>
                    <a href="www.facebook.com">
                        <i class=" bi bi-facebook text-light fs-2"></i>
                    </a>
                    <a href="www.tiktok.com">
                        <i class=" bi bi-tiktok text-light fs-2"></i>
                    </a>
                    </div>
                    <a href="mailto:destek@@mvcecommerce.com" class="text-warning text-decoration-none"">destek@@mvcecommerce.com</a>
                    <a href="tel:+90 555 555 2222" class="text-warning text-decoration-none">+90 555 555 2222</a>
</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.3/dist/sweetalert2.all.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.3/dist/sweetalert2.min.css">
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $('.app-dropdown-toggle').hover(
            function () {
                $(this).find('.app-dropdown').addClass('active');
            },
            function () {
                $(this).find('.app-dropdown').removeClass('active');
            }
        );
        @if (TempData["success"]!= null)
        {
             <text>
        Swal.fire({
            icon:'success',
            title: 'Thanks You!',
            html: '@TempData["success"]',
            toast: true,
            position: 'top-end'
        })
            </text>
        }


    </script>

</body>
</html>
