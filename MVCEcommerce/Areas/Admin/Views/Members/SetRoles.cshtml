@inject RoleManager<Role> roleManager
@model  User

@{

    ViewData["Title"] = $"{Model.GivenName} Yetkileri";
}

<form  method="post">


<div class="row row-cols-1 row-cols-md-4" >
    @foreach (var role in roleManager.Roles.ToList())
	{
        <div class="col">
            <div class="form-check">
                <input type="checkbox" @(Model.UserRoles.Any(p=>p.Role.Name == role.Name) ? "checked" : "") class="form-check-input" name="Roles" id="check_@role.Name" value="@role.Name" />
                <label class="form-check-label"for="check_@role.Name">
                    @role.DisplayName
                </label>
            </div>
        </div>
	}
</div>
    <hr />
    <div class="d-flex py-2">
        <button type="submit" class="btn btn-success ml-auto"> Kaydet </button>
        <a asp-action="Index" class="btn btn-link "> İptal </a>

    </div>

</form>